\name{v-tropmaize-map}
\alias{v-tropmaize-map}
\alias{v.tropmaize.map}
\docType{data}
\title{Genetic Map for Tropical Maize}
\description{
Marker names, chromosome assignments, and map positions for tropical maize.
}
\usage{
data("v-tropmaize-map")
}
\format{
A data frame with 7140 rows and 3 variables:
\describe{
  \item{\code{name}}{Character marker name.}
  \item{\code{chrom}}{Integer chromosome number.}
  \item{\code{pos}}{Numeric marker position in the units used in the
  original map.}
}
}
\source{
Prepared from the original \file{ex-crossa.map} text file.
}
\keyword{datasets}
