\name{v-tropmaize-map}
\alias{v-tropmaize-map}
\alias{v.tropmaize.map}
\docType{data}
\title{Genetic Map for Tropical Maize}
\description{
Marker names, chromosome assignments, and map positions for tropical maize.
}
\usage{
data("v-tropmaize-map")
}
\format{
A data frame with 7140 rows and 3 variables:
\describe{
  \item{\code{name}}{Character marker name.}
  \item{\code{chrom}}{Integer chromosome number.}
  \item{\code{pos}}{Numeric marker position in the units used in the
  original map.}
}
}
\source{
Jose Crossa, Gustavo de los Campos, Paulino Perez, Daniel Gianola, 
Juan Burgueno, Jose Luis Araus, Dan Makumbi, Ravi P Singh, Susanne Dreisigacker, 
Jianbing Yan, Vivi Arief, Marianne Banziger, Hans-Joachim Braun, 
Prediction of Genetic Values of Quantitative Traits in Plant Breeding Using Pedigree and Molecular Markers, 
Genetics, Volume 186, Issue 2, 1 October 2010, Pages 713-724, 
\doi{10.1534/genetics.110.118521}
}
\keyword{datasets}
