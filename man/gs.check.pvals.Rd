\name{gs.check.pvals}
\alias{gs.check.pvals}
\title{Checks whether p-values are available for a genomic-selection data set}

\description{
Checks whether p-values are available for a genomic-selection data set.
}

\usage{
gs.check.pvals(data.set ="default")
}

\arguments{
   \item{data.set}{Name of the SelectionTools data set.}
}
\value{
A logical scalar indicating whether p-values are available for the requested genomic-selection data set.
}
