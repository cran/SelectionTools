\name{Mf_technow}
\alias{Mf_technow}
\docType{data}
\title{Technow Flint Marker Data}
\description{
Marker data for the flint parental lines corresponding to the hybrid
phenotype data in \code{DT_technow}.  The data are used to construct
genomic relationship matrices and for genomic-prediction examples.
}
\usage{
data(Mf_technow)
}
\format{
A marker-data matrix or data frame with flint parental lines in rows and
markers in columns.  Row names identify the parental lines and the entries
contain marker genotypes.
}
\source{
Data supplied with SelectionTools for genomic-prediction examples.
}
\keyword{datasets}
