\name{effmap.remove}
\alias{effmap.remove}
\title{Removes a stored effect map}

\description{
Removes a stored effect map.
}

\usage{
effmap.remove(Name)
}

\arguments{
   \item{Name}{Name identifying the object to be processed.}
}
\value{
An invisible \code{list} returned by the compiled routine. The list is an implementation-level result containing the arguments returned by the compiled routine; the function is primarily called for its side effect of removing the requested effect map.
}
