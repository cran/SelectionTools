\name{population.plabsim.save}
\alias{population.plabsim.save}
\title{Saves a population in PLABSIM-style format}

\description{
Writes a simulation population and its stored individual information in the PLABSIM-style file representation.
}

\usage{
population.plabsim.save(file, PopName)
}

\arguments{
   \item{file}{File name or file connection.}
   \item{PopName}{Name of the population.}
}
\value{
\code{NULL}. The function is called for its side effect of writing the population and individual information in the PLABSIM-style representation.
}
