\name{st.LDplot.map}
\alias{st.LDplot.map}
\title{Linkage-disequilibrium information for plotting}

\description{
Prepares linkage-disequilibrium information for plotting.
}

\usage{
st.LDplot.map(chrom, data.set)
}

\arguments{
   \item{chrom}{Chromosome identifier.}
   \item{data.set}{Name of the SelectionTools data set.}
}
\value{
A numeric vector containing map positions for the requested chromosome.
}
