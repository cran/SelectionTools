\name{st.plot.corr}
\alias{st.plot.corr}
\title{Plots correlation information from SelectionTools results}

\description{
Plots correlation information from SelectionTools results.
}

\usage{
st.plot.corr(x, y, title = "", pch = 16, cex = 1, xlab = "x", ylab = "y")
}

\arguments{
   \item{x}{Input object.}
   \item{y}{Response vector.}
   \item{title}{Function argument used by this operation.}
   \item{pch}{Function argument used by this operation.}
   \item{cex}{Function argument used by this operation.}
   \item{xlab}{Function argument used by this operation.}
   \item{ylab}{Function argument used by this operation.}
}
\value{
No useful return value is intended. The function is called for its side effect of plotting correlation information.
}
