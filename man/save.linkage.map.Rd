\name{save.linkage.map}
\alias{save.linkage.map}
\title{Save a linkage map}

\description{
Save a linkage map.
}

\usage{
save.linkage.map(file, dta.map=get.map())
}

\arguments{
   \item{file}{File name or file connection.}
   \item{dta.map}{Map-related parameter.}
}
\value{
\code{NULL}, returned by the delegated \code{linkage.map.save()} file-writing operation. The function is a compatibility wrapper.
}
