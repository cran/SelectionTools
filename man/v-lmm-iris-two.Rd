\name{v-lmm-iris-two}
\alias{v-lmm-iris-two}
\alias{iris.two}
\docType{data}
\title{Two Iris Species for Hotelling's Test}
\description{Sepal measurements on ten plants from each of two Iris species, used for the pooled-covariance Hotelling two-sample test.}
\usage{data("v-lmm-iris-two", package = "SelectionTools")}
\format{A \code{data.frame} named \code{iris.two} with 20 rows and 3 columns.
\describe{
\item{\code{SepalLength}}{Sepal length in centimetres. Numeric (double).}
\item{\code{SepalWidth}}{Sepal width in centimetres. Numeric (double).}
\item{\code{Species}}{Species identifier. Factor with levels versicolor and virginica.}
}}
\details{The stored data contain no missing values.}
\value{Loading the dataset creates the \code{iris.two} data frame.}
\seealso{\code{\link{st.lmm}}, \code{\link{st.lsm}}, \code{\link{v-lmm-data}}}
\keyword{datasets}
