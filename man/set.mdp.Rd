\name{set.mdp}
\alias{set.mdp}
\title{Sets marker-assisted donor-parent information}

\description{
Sets marker-assisted donor-parent information.
}

\usage{
set.mdp(MDP=0)
}

\arguments{
   \item{MDP}{Function argument used by this operation.}
}
\value{
An invisible \code{list} returned by the compiled routine. The list is an implementation-level result containing the arguments returned by the compiled routine; the function is primarily called for its side effect of setting marker-assisted donor-parent information.
}
