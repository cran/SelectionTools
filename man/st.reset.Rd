\name{st.reset}
\alias{st.reset}
\title{Resets SelectionTools data and settings}

\description{
Resets SelectionTools data and settings.
}

\usage{
st.reset()
}
\value{
An invisible \code{list} returned by the compiled routine. The list is an implementation-level result containing the arguments returned by the compiled routine; the function is primarily called for its side effect of resetting SelectionTools marker-data state.
}
