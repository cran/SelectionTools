\name{get.population.info}
\alias{get.population.info}
\title{Return stored information for individuals in a population}

\description{
Return stored information for individuals in a population.
}

\usage{
get.population.info(PopName, ind)
}

\arguments{
   \item{PopName}{Name of the population.}
   \item{ind}{Individual index or indices.}
}
\value{
Returns the same character value or \code{NULL} as \code{population.info.get()}.
}
