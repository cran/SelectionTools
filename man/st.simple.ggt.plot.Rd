\name{st.simple.ggt.plot}
\alias{st.simple.ggt.plot}
\title{Create a simple graphical genotype plot}

\description{
Create a simple graphical genotype plot.
}

\usage{
st.simple.ggt.plot(data.set="default", ...)
}

\arguments{
   \item{data.set}{Name of the SelectionTools data set.}
   \item{...}{Additional arguments passed to the underlying operation.}
}
\value{
\code{NULL}. The function is called for its side effect of creating one or more graphical-genotype PDF files.
}
