\name{DT_technow}
\alias{DT_technow}
\docType{data}
\title{Technow Hybrid Phenotype Data}
\description{
Phenotypic data for a maize hybrid data set used for examples of genomic
prediction in SelectionTools.  The records identify dent and flint
parents, their hybrid, and grain-yield performance.
}
\usage{
data(DT_technow)
}
\format{
A data frame containing the variables \code{dent}, \code{flint},
\code{hy}, and \code{GY}.  The first two variables identify the parental
lines, \code{hy} identifies the hybrid, and \code{GY} contains grain-yield
phenotypes.
}
\source{
Data supplied with SelectionTools for genomic prediction examples.
Original data published in Technow et al. (2014):
\doi{10.1534/genetics.114.165860}.
}
\keyword{datasets}
