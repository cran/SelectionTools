\name{st.LDplot.ld}
\alias{st.LDplot.ld}
\title{Linkage-disequilibrium information for plotting}

\description{
Prepares linkage-disequilibrium information for plotting.
}

\usage{
st.LDplot.ld(ld, chrom)
}

\arguments{
   \item{ld}{Function argument used by this operation.}
   \item{chrom}{Chromosome identifier.}
}
\value{
A numeric matrix containing the linkage-disequilibrium values arranged for plotting.
}
