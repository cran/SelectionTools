\name{swap.population.name}
\alias{swap.population.name}
\title{Swap population names}

\description{
Swap population names.
}

\usage{
swap.population.name(NameP1, NameP2)
}

\arguments{
   \item{NameP1}{Name of the first parental population.}
   \item{NameP2}{Name of the second parental population.}
}
\value{
Returns the same invisible implementation-level \code{list} as \code{population.swap.name()}. The function is a compatibility wrapper and the meaningful result is the delegated population operation.
}
