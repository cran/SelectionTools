% Documentation generated by roxygen2.
\name{define.effects.df}
\alias{define.effects.df}
\title{define.effects.df()}
\usage{
define.effects.df ( LocNames )
}
\arguments{
\item{LocNames}{Name of the loci for which standard effects of 1 are generated}
}
\value{
\code{NULL}. The function is called for its side effect of defining effect maps for the locus names in the supplied data frame; existing matching effect maps are retained while other requested loci are processed.
}
\description{
Automatically generates effects for loci: effect is always 1 for allele 1.
}
\details{
Locus names refer to the installed simulation map. Each generated effect map
is named \code{EFF} followed by the locus name and \code{1}.
}
\examples{
data("v-tropmaize-map", package = "SelectionTools")
map <- v.tropmaize.map[1:12, c("chrom", "pos", "name")]
map$pos <- map$pos / 100
define.genome(map)
define.effects.df(map$name)
}
