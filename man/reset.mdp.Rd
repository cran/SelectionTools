\name{reset.mdp}
\alias{reset.mdp}
\title{Resets marker-assisted donor-parent information}

\description{
Resets marker-assisted donor-parent information.
}

\usage{
reset.mdp()
}
\value{
An invisible \code{list} returned by the compiled routine. The list is an implementation-level result containing the arguments returned by the compiled routine; the function is primarily called for its side effect of resetting marker-assisted donor-parent information.
}
