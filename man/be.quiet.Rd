\name{be.quiet}
\alias{be.quiet}
\title{Switch SelectionTools output to a quiet mode}

\description{
Switch SelectionTools output to a quiet mode.
}

\usage{
be.quiet()
}
\value{
Returns the same invisible implementation-level \code{list} as \code{set.info.level(0)}; the main effect is switching package information output to quiet mode.
}
