\name{plabsim.init}
\alias{plabsim.init}
\title{Initialize the PLABSIM simulation state}

\description{
Initialize the PLABSIM simulation state.
}

\usage{
plabsim.init()
}
\value{
Returns the same invisible implementation-level \code{list} as \code{rng.init()}; the main effect is initializing the simulation random-number generator state.
}
