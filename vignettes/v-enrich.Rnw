\begin{document}
\begin{center}
\h{Haplotype enrichment in tropical maize}{Matthias Frisch}
\end{center}
\setcounter{tocdepth}{1}
\def\contentsname{\textcolor{black}{}}
\tableofcontents
\vskip2truecm
\section{Prepare and phase the populations}

<<setup-display,eval=FALSE,echo=FALSE>>=
library(SelectionTools)
options(
    width = 68,
    digits = 5,
    bitmapType = "cairo"
)
st.set.num.threads(1)
st.set.info.level(-1)
@
<<setup-figures,eval=FALSE,echo=FALSE>>=
output.dir <- getOption("SelectionTools.enrichment.dir", getwd())
figure.dir <- file.path(output.dir, "figures")
dir.create(
    figure.dir,
    recursive = TRUE,
    showWarnings = FALSE
)
@
\subsection*{Load the tropical maize data}

We consider 264 tropical maize lines from CIMMYT's
Drought Tolerance Maize for Africa project that were analyzed with 1135 SNP
markers. Data from Crossa et al.\ (2010). The original marker data are
available from the Genetics webpage. Thanks to Dr.\ Jose Crossa and
Dr.\ Raman Babu for providing the map data and the permission to use
this data set as an example for data analysis.

The tropical maize data are distributed with the package. We keep the
original data and create a separate working copy for filtering.

<<load,eval=FALSE>>=
data("v-tropmaize-vcf")
st.load.vcf.data(
    v.tropmaize.vcf,
    data.set = "base"
)
st.copy.marker.data("clustering", "base")
@
\subsection*{Filter markers and lines}

Retain biallelic markers with at most 10\% missing genotypes.

<<filter-markers,eval=FALSE>>=
st.restrict.marker.data(
    NoAll.MAX = 2,  # At most two alleles per marker
    MaMis.MAX = 0.1, # Missing-call limit per marker
    data.set = "clustering"
)
@
Remove lines with more than 10\% missing genotypes, then retain markers
with expected heterozygosity of at least 0.1.

<<filter-lines,eval=FALSE>>=
st.restrict.marker.data(
    InMis.MAX = 0.1, # Missing-call limit per line
    data.set = "clustering"
)
st.restrict.marker.data(
    ExHet.MIN = 0.1, # Retain polymorphic, informative markers
    data.set = "clustering"
)
@
Obtain statistics for the filtered markers and list the available datasets.

<<filter-summary,eval=FALSE>>=
filtered <- st.marker.data.statistics(
    data.set = "clustering",
    gen = FALSE # Omit the large genotype table
)
st.data.set.list()
@
\subsection*{Define five clusters}

Calculate the Rogers distance matrix from the filtered marker data.

<<cluster-distances,eval=FALSE>>=
dist.mat <- st.genetic.distances(
    measure = "rd", # Rogers distance between lines
    format = "m",   # R 'dist' object for cmdscale
    data.set = "clustering"
)
@
Apply k-means to its rows using a fixed seed to reproduce the five clusters.

<<cluster-groups,eval=FALSE>>=
set.seed(1) # Reproduce the random starts and cluster labels
clus <- kmeans(
    as.matrix(dist.mat), # Rows are distance profiles, not SNPs
    centers = 5,
    nstart = 25          # Keep the best of 25 random starts
)
clusters <- clus$cluster
@
Calculate principal coordinates for the figure and display the cluster sizes.

<<cluster-coordinates,eval=FALSE>>=
pco <- cmdscale( # Principal coordinates from Rogers distances
    dist.mat,
    k = 4,       # Retain four axes; plot the first two below
    eig = TRUE   # Keep eigenvalues to assess the embedding
)
PC <- pco$points
print(table(clusters))
@
\begin{Soutput}
clusters
 1  2  3  4  5 
90  6 83 10 43 
\end{Soutput}
The first two principal coordinates show the five clusters with the same
plotting settings used for the selected-donor comparison below.

<<pcoa-initial-device,eval=FALSE,echo=FALSE>>=
cluster.colours <- c("black", "#DF536B", "#61D04F",
                     "#2297E6", "#28E2E5")
png(
    file.path(figure.dir, "enrichment-clusters-initial.png"),
    width = 1000,
    height = 750,
    pointsize = 18,
    res = 120
)
par(mar = c(4.5, 4.5, 2, 1))
@
<<pcoa-initial-plot,eval=FALSE>>=
plot(
    PC[, 1],
    PC[, 2],
    col = cluster.colours[clusters], # Stable cluster colours
    pch = 16,
    xlab = "Principal coordinate 1",
    ylab = "Principal coordinate 2"
)
@
<<pcoa-initial-legend,eval=FALSE,echo=FALSE>>=
legend(
    "topright",
    pch = 16,
    bty = "n",
    col = cluster.colours,
    legend = c("1: excluded", "2: excluded", "3: main",
                "4: pool A", "5: pool B")
)
invisible(dev.off())
@

\begin{center}
\includegraphics[width=0.70\hsize]{figures/enrichment-clusters-initial.png}
\end{center}



\subsection*{Choose the main and donor populations}

The green cluster 3 is the base population. Cluster 4 (blue) supplies
pool A and cluster 5 (light green/turquoise) supplies pool B. Clusters 1
and 2 are excluded. Both pools are derived from the same marker data,
so marker identities, maps and allele coding agree.

<<pools,eval=FALSE>>=
main.ind <- names(clusters)[clusters == 3]
a.pool <- names(clusters)[clusters == 4]
b.pool <- names(clusters)[clusters == 5]
pools <- list(A = sort(a.pool), B = sort(b.pool))
joint.ind <- c(main.ind, a.pool, b.pool)
@
Summarize the cluster identities and line counts of the three populations.

<<pool-sizes,eval=FALSE>>=
populations <- data.frame(
    Population = c("Main", "A", "B"),
    Cluster = c(3, 4, 5),
    Lines = c(length(main.ind), length(a.pool), length(b.pool))
)
print(populations, row.names = FALSE)
@
\begin{Soutput}
 Population Cluster Lines
       Main       3    83
          A       4    10
          B       5    43
\end{Soutput}

\subsection*{Create separate marker datasets}

Copy the filtered dataset and retain only the base-population lines.

<<copy-base,eval=FALSE>>=
st.copy.marker.data("base.phased", "clustering")
st.restrict.marker.data(ind.list=main.ind, data.set="base.phased")
@
Copy the filtered dataset and retain only the lines in donor pool A.

<<copy-a,eval=FALSE>>=
st.copy.marker.data("A.phased", "clustering")
st.restrict.marker.data(ind.list=a.pool, data.set="A.phased")
@
Copy the filtered dataset and retain only the lines in donor pool B.

<<copy-b,eval=FALSE>>=
st.copy.marker.data("B.phased", "clustering")
st.restrict.marker.data(ind.list=b.pool, data.set="B.phased")
@
\subsection*{Phase the base population}

The tropical maize accessions are inbred lines, and we use
\cde{st.phase} here only to impute missing marker calls.
Their predominantly homozygous genotypes leave little ambiguity about phase.
Each population is processed separately with a fixed seed, and
\cde{impute=TRUE} retains the inferred calls at missing marker genotypes.

<<phase-base,eval=FALSE>>=
st.phase(
    impute = TRUE, # Retain inferred calls at missing genotypes
    phasing.options = list(seed = 20261003), # Reproducible calls
    data.set = "base.phased"
)
@
\subsection*{Phase donor pool A}

Use a separate, reproducible seed for the first donor pool.

<<phase-a,eval=FALSE>>=
st.phase(
    impute = TRUE, # Retain inferred calls at missing genotypes
    phasing.options = list(seed = 20261004),
    data.set = "A.phased"
)
@
\subsection*{Phase donor pool B}

Apply the same phasing settings to the second donor pool.

<<phase-b,eval=FALSE>>=
st.phase(
    impute = TRUE, # Retain inferred calls at missing genotypes
    phasing.options = list(seed = 20261005),
    data.set = "B.phased"
)
@
\section{Enrichment using haplotyping options}

\subsection*{Define haplotyping options once}

This workflow uses non-overlapping windows of five adjacent markers.
Short terminal windows are retained, and no block crosses a chromosome
boundary. The same options are reused in every call; blocks are defined
from the base population, so selecting donors cannot change their borders.

<<options,eval=FALSE>>=
haplotype.options <- list(
    hap = 5,
    hap.unit = 1 # Block size is measured in markers
)
@
\subsection*{Select five donors from pool A}

Forward selection adds the donor with the greatest remaining gain at each
of five steps. Shared variants count once per block. With
\cde{exclude.compatible=TRUE}, variants compatible with incomplete base
calls are excluded from the score. The returned genotype names follow
selection order.

<<select-a,eval=FALSE>>=
# Shared donor variants count once in the combined gain.
forward.A <- st.select.enrichment(
    base.pool          = "base.phased",
    enrichment.pool    = "A.phased",
    n                  = 5,
    haplotype.options  = haplotype.options,
    exclude.compatible = TRUE,
    method             = "forward"
)
print(forward.A)
@
\begin{Soutput}
[1] "228" "213" "232" "217" "218"
\end{Soutput}

\subsection*{Create the selected donor dataset}

Copy and restrict the donor pool using those names.

<<restrict-a,eval=FALSE>>=
st.copy.marker.data("selected.A", "A.phased")
st.restrict.marker.data(ind.list=forward.A, data.set="selected.A")
@
\subsection*{Calculate enrichment from the selected lines}

Calculate the additional block-specific haplotypes contributed jointly by the five selected lines.

<<calculate-a,eval=FALSE>>=
gain.A <- st.calculate.enrichment(
    base.pool = "base.phased",
    enrichment.pool = "selected.A", # Only the five chosen donors
    haplotype.options = haplotype.options,
    exclude.compatible = TRUE # Exclude uncertain additions
)
print(gain.A$summary, row.names = FALSE)
@
\begin{Soutput}
 Base.lines Enrichment.lines Main Additional Hidden No.match Score
         83                5 2218         17      0       17    17
 Enriched Gaining.blocks
     2235             16
\end{Soutput}

The printed summary contains the following quantities.

\begin{itemize}
\item \cde{Base.lines}: Number of lines in the base population used for the comparison. Here all 83
phased base lines are retained, and both stored homologues of each line
contribute to the haplotype catalogue. This is a count of individuals; the
diversity they represent is reported separately in \cde{Main}.

\item \cde{Enrichment.lines}: Number of donor lines included in the enrichment calculation. Here the donor
dataset contains the five selected lines from pool A, rather than all ten
candidates. Both homologues contribute, but a variant carried by several
selected donors is counted only once within its block.

\item \cde{Main}: Number of distinct complete haplotypes observed in the base population,
summed over all blocks; here the total is 2218. Repeated copies within one
block count once, while variants at different blocks count separately.
Incomplete haplotypes do not enter this observed-allele count.

\item \cde{Additional}: Number of distinct complete donor haplotypes absent from the complete base
calls at the corresponding blocks. The five donors supply 17 such variants,
each counted once per block. This total includes both uncertain and
unambiguous additions, so it equals \cde{Hidden + No.match}.

\item \cde{Hidden}: Number of additional variants compatible with at least one incomplete base
homologue at all its observed markers. Such variants may already occur where
base calls are missing and are excluded from the present score. Here the
count is zero because the imputed base haplotypes contain no missing calls.

\item \cde{No.match}: Number of additional variants incompatible with every incomplete base
haplotype at the corresponding block. These variants are absent from
complete base calls and cannot be hidden in incomplete calls. Here all base
calls have been imputed, so all 17 additional variants fall into this
category.

\item \cde{Score}: Number of additional variants credited by the selection criterion; here the
score is 17. With \cde{exclude.compatible=TRUE}, it equals
\cde{No.match}. The \cde{Hidden} count is zero in this example, so
including compatible variants would give the same score, equal to
\cde{Additional}.

\item \cde{Enriched}: Total number of distinct complete haplotypes represented after combining the
base population and selected donors. It is calculated as \cde{Main +
Additional}, giving $2218+17=2235$ here. Shared variants count once within
their block, regardless of how many base or donor lines carry them.

\item \cde{Gaining.blocks}: Number of blocks with at least one additional observed donor haplotype; here
16 blocks gain diversity. Each block counts once, even if it contains
several additional variants. Blocks whose additions are all classified as
hidden also count, because this quantity is based on \cde{Additional}.

\end{itemize}

\subsection*{Select five donors from pool B}

Repeat the same analysis for the second pool, retaining the same base population and options.

<<select-b,eval=FALSE>>=
# Keep the same base and blocks for a comparable pool-B gain.
forward.B <- st.select.enrichment(
    base.pool          = "base.phased",
    enrichment.pool    = "B.phased",
    n                  = 5,
    haplotype.options  = haplotype.options,
    exclude.compatible = TRUE,
    method             = "forward"
)
print(forward.B)
@

\begin{Soutput}
[1] "140" "156" "175" "133" "154"
\end{Soutput}

Copy pool B and retain only the five selected donor lines.

<<restrict-b,eval=FALSE>>=
st.copy.marker.data("selected.B", "B.phased")
st.restrict.marker.data(ind.list=forward.B, data.set="selected.B")
@


\subsection*{Calculate enrichment from pool B}

One additional allele means one additional variant at one block, not at
every block. The two pool comparisons remain separate; their gains must
not be added because they may introduce the same variants.

<<calculate-b,eval=FALSE>>=
gain.B <- st.calculate.enrichment(
    base.pool = "base.phased",
    enrichment.pool = "selected.B", # Only the five chosen donors
    haplotype.options = haplotype.options,
    exclude.compatible = TRUE # Exclude uncertain additions
)
print(gain.B$summary, row.names = FALSE)
@
\begin{Soutput}
 Base.lines Enrichment.lines Main Additional Hidden No.match Score
         83                5 2218         60      0       60    60
 Enriched Gaining.blocks
     2278             51
\end{Soutput}

\subsection*{Inspect individual blocks}

The detailed tables identify where enrichment occurs and which sequences
are added. The examples below display their first rows; complete results
remain in the returned objects.

<<details,eval=FALSE>>=
print(head(gain.B$by.block), row.names = FALSE)
print(head(gain.B$alleles), row.names = FALSE) # Added sequences
@
\begin{Soutput}
   Block Main Hidden No.match Additional Score Enriched
 b000000   10      0        0          0     0       10
 b000001   13      0        2          2     2       15
 b000002   12      0        1          1     1       13
 b000003   17      0        0          0     0       17
 b000004   18      0        3          3     3       21
 b000005   10      0        1          1     1       11
   Block  Sequence Hidden
 b000001 1;2;1;1;2  FALSE
 b000001 1;1;2;1;2  FALSE
 b000002 2;1;2;1;1  FALSE
 b000004 1;2;1;2;1  FALSE
 b000004 1;1;2;2;1  FALSE
 b000004 2;2;2;2;1  FALSE
\end{Soutput}


\section{Enrichment using fixed block borders}

\subsection*{Define and retain the block borders}

Construct explicitly the same non-overlapping five-marker blocks used
above, retaining short terminal blocks at chromosome ends.

<<fixed-blocks,eval=FALSE>>=
blocks <- st.def.hblocks(
    hap = 5,
    hap.unit = 1, # Block size is measured in markers
    data.set = "base.phased"
)
@
Display the first five block definitions, including their marker membership.

<<fixed-block-display,eval=FALSE>>=
print(head(blocks, 5), row.names = FALSE)
@
\begin{Soutput}
 Chrom     Pos    Name Class
     1  3.5672 b000000     b
     1  7.1442 b000001     b
     1 11.1725 b000002     b
     1 13.9740 b000003     b
     1 22.8237 b000004     b
                                             Markers
  PZA036132;PZA036131;PZA036142;PZA036141;PZA003931;
  PZA003934;PZB019151;PZA035181;PZA035191;PZA035201;
  PZA035203;PZA035204;PZA035211;PZA035511;PZA035521;
  PZA035583;PZA035571;PZA036631;PZA036622;PHM165331;
 PZB007186;PZA0035812;PZD000971;PZA029219;PZB025153;
\end{Soutput}

A table with the same \cde{Name}, \cde{Chrom} and \cde{Markers}
columns can also be constructed or imported to use arbitrary block borders.
The \cde{Markers} column lists marker names separated by semicolons.
Each block must contain consecutive markers on one chromosome, block names
must be unique, and blocks must not overlap.

\subsection*{Select donors using the fixed blocks}

Supply this table to select five donors from pool A, using the same block
borders and enrichment criterion as in the earlier example.

<<fixed-select-a,eval=FALSE>>=
forward.fixed.A <- st.select.enrichment(
    base.pool          = "base.phased",
    enrichment.pool    = "A.phased",
    n                  = 5,
    blocks             = blocks,
    exclude.compatible = TRUE,
    method             = "forward"
)
print(forward.fixed.A)
@
\begin{Soutput}
[1] "228" "213" "232" "217" "218"
\end{Soutput}

\section{Comparison of the two pools}

The principal-coordinate plot shows the five clusters, with circles marking
the five selected donors from each pool.

<<plot-results,eval=FALSE,echo=FALSE>>=
a.ind <- forward.A
b.ind <- forward.B
result <- rbind(gain.A$summary, gain.B$summary)
result$Pool <- c("A", "B")
@
<<pcoa-device,eval=FALSE,echo=FALSE>>=
png(
    file.path(figure.dir, "enrichment-clusters.png"),
    width = 1000,
    height = 750,
    pointsize = 18,
    res = 120
)
par(mar = c(4.5, 4.5, 2, 1))
plot(
    PC[, 1],
    PC[, 2],
    col = cluster.colours[clusters], # Stable cluster colours
    pch = 16,
    xlab = "Principal coordinate 1",
    ylab = "Principal coordinate 2"
)
@
<<pcoa-labels,eval=FALSE,echo=FALSE>>=
points(
    PC[c(a.ind, b.ind), 1],
    PC[c(a.ind, b.ind), 2],
    pch = 1,
    cex = 1.6,
    lwd = 1.5
)
legend(
    "topright",
    pch = 16,
    bty = "n",
    col = cluster.colours,
    legend = c("1: excluded", "2: excluded", "3: main",
                "4: pool A", "5: pool B")
)
invisible(dev.off())
@
<<gain-plot,eval=FALSE,echo=FALSE>>=
png(
    file.path(figure.dir, "enrichment-gain.png"),
    width = 900,
    height = 650,
    pointsize = 18,
    res = 120
)
barplot(
    rbind(result$No.match, result$Hidden),
    names.arg = paste("Main +", result$Pool),
    ylim = c(0, 1.8 * max(result$Additional)),
    col = c("cornflowerblue", "coral"),
    ylab = "Additional block-specific alleles",
    legend.text = c("No compatible missing call", "Potentially hidden"),
    args.legend = list(x = "topright", bty = "n")
)
invisible(dev.off())
@
<<plot-pools,eval=FALSE,echo=FALSE>>=
pool.names <- c("base.phased", "A.phased", "B.phased")
phased <- lapply(pool.names, function(x) {
    st.marker.data.statistics(data.set = x)
})
@
<<plot-input,eval=FALSE,echo=FALSE>>=
snp <- do.call(cbind, lapply(phased, function(x) {
    as.matrix(x$genotypes[, -1, drop = FALSE])
}))
rownames(snp) <- phased[[1]]$genotypes[[1]]
missing.codes <- c("-1", "--", "-", ".", "NA", "255")
block.markers <- strsplit(gain.A$blocks$Markers, ";", fixed = TRUE)
@
<<split-homologues,eval=FALSE,echo=FALSE>>=
homologue <- function(x, which) {
    parts <- strsplit(as.vector(x), "/", fixed = TRUE)
    values <- vapply(parts, function(z) {
        if (length(z) == 2L) z[which] else NA_character_
    }, character(1))
    # Never treat missing calls as an observed haplotype allele.
    values[values %in% missing.codes] <- NA_character_
    matrix(values, nrow(x), dimnames = dimnames(x))
}
@
<<make-homologues,eval=FALSE,echo=FALSE>>=
h1 <- homologue(snp, 1)
h2 <- homologue(snp, 2)
stopifnot(identical(dimnames(h1), dimnames(h2)))
@
<<plot-sequences,eval=FALSE,echo=FALSE>>=
block.sequence <- function(markers) {
    cbind(h1[markers, , drop = FALSE], h2[markers, , drop = FALSE])
}
sequences <- lapply(block.markers, block.sequence)
complete.calls <- function(x) {
    apply(x, 2, function(z) {
        if (anyNA(z)) NA_character_ else paste(z, collapse = ";")
    })
}
@
<<plot-codes,eval=FALSE,echo=FALSE>>=
plot.block <- function(x) {
    z <- complete.calls(x)
    # Rank alleles across all three pools for shared figure colours.
    counts <- sort(table(z), decreasing = TRUE)
    ranks <- match(z, names(counts))
    ranks[is.na(ranks)] <- -1L
    n <- ncol(x) / 2L
    paste(ranks[seq_len(n)], ranks[n + seq_len(n)], sep = "/")
}
plot.genotypes <- t(vapply(sequences, plot.block,
                          character(ncol(snp))))
@
<<plot-map,eval=FALSE,echo=FALSE>>=
colnames(plot.genotypes) <- colnames(snp)
rownames(plot.genotypes) <- gain.A$blocks$Name
plot.map <- gain.A$blocks[, c("Chrom", "Pos", "Name")]
max.rank <- max(vapply(sequences, function(x) {
    length(unique(na.omit(complete.calls(x))))
}, integer(1)))
base.colours <- eval(formals(st.plot.ggt)$color)
ggt.colours <- c(base.colours,
    hcl.colors(max(1, max.rank - length(base.colours)), "Dark 3"))
ggt.colours <- ggt.colours[seq_len(max.rank)]
@
<<plot-choice,eval=FALSE,echo=FALSE>>=
# Read base IDs from the actual enrichment dataset, not a new pool.
base.ids <- sort(colnames(phased[[1]]$genotypes)[-1])
selected <- list(A = list(Lines = forward.A), B = list(Lines = forward.B))
@
<<ggt-function,eval=FALSE,echo=FALSE>>=
draw.ggt <- function(group) {
    ids <- c(selected[[group]]$Lines, base.ids)
    labels <- paste(c(rep(group, 5), rep("M", length(base.ids))), ids)
    st.plot.ggt.src(
        map = plot.map,
        pop = as.data.frame(plot.genotypes[, ids]),
        f.lr = 0.7,
        f.tb = 2,
        d.h = 0.001,
        d.v = 0.0003,
        p.t = FALSE,
        p.s = FALSE,
        d.t = 50,
        d.map = 100,
        c.nme = as.character(sort(unique(plot.map$Chrom))),
        i.nme = labels,
        color = ggt.colours,
        z.min = 1,
        z.max = max.rank,
        cex.chrom = 0.6,
        cex.ind = 0.53
    )
}
@
<<ggt-a,eval=FALSE,echo=FALSE>>=
png(
    file.path(figure.dir, "enrichment-ggt-A.png"),
    width = 1000,
    height = 1414,
    pointsize = 20,
    res = 120,
    antialias = "none"
)
draw.ggt("A")
invisible(dev.off())
@
<<ggt-b,eval=FALSE,echo=FALSE>>=
png(
    file.path(figure.dir, "enrichment-ggt-B.png"),
    width = 1000,
    height = 1414,
    pointsize = 20,
    res = 120,
    antialias = "none"
)
draw.ggt("B")
invisible(dev.off())
@

