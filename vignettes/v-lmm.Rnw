\mbox{\cde{CM17: Motor Trend car measurements; RLab-StatLrn/q049-15-e1-s.R}}

<<CM17-search,eval=FALSE>>=
data("v-lmm-mtcars", package = "SelectionTools")
m.mtcars.subsets <- st.lmm(
    mpg ~ .,
    data = mtcars,
    method = "moments",
    selection = list(
        search = "exhaustive",
        nvmax = 7,
        nbest = 1,
        criterion = "adjr2"
    )
)
@

