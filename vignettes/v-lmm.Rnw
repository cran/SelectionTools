gca.missing.predictions <- sum(is.na(gca.predictions))
gca.missing.predictions
@

\begin{Soutput}
[1] 0
\end{Soutput}

\subsubsection{GCA plus SCA and prediction of missing responses}

The interaction \cde{flint:dent} adds a third random term to the model.
Its quoted \cde{"kro(a,a)"} request derives the interaction relationships
from the two parental matrices. \cde{prediction = "NAonly"} stores
predictions for the missing responses in the performance frame.

<<H03-fit,eval=FALSE>>=
hybrid.gca.sca <- st.lmm(
    fixed = GY ~ 1,
    random = ~flint + dent + flint:dent,
    ucov = list(
        "flint" = "A",
        "dent" = "A",
        "flint:dent" = "kro(a,a)"
    ),
    data = "maizehybrids",
    prediction = "NAonly"
)
hybrid.gca.sca
@

