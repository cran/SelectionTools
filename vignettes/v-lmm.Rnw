<<CM08-6,eval=FALSE>>=
# Mean order: Cossack/A, Ladack/A, Cossack/B, Ladack/B.
C.alf <- rbind(
    within.plot = c(1, 0, -1, 0),
    across.plots = c(1, 0, 0, -1)
)
# Within Cossack: A - B. Across varieties: Cossack/A - Ladack/B.
h.alf.cells <- st.lsm(
    m.alfalfa,
    ~Variety * Date,
    at = list(
        Variety = c("Cossack", "Ladack"),
        Date = c("A", "B")
    ),
    method = C.alf,
    adjust = "none"
)
h.alf.cells
@

\begin{Soutput}
