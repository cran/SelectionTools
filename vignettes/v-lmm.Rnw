  across.p~2     0.46 0.14 24.08     0.18     0.74 3.38  0.0024 Satterthw~1
  within.p~1 [contrast] = within.plot
  across.p~2 [contrast] = across.plots
  Satterthw~1 [DF method] = Satterthwaite
p-value adjustment: none; confidence level: 0.9500
