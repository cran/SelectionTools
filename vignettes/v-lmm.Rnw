  lne16  3625.0485  195.7737  12.43  3200.1157  4049.9813
  lne17  3402.6488  195.7737  12.43  2977.7159  3827.5816
  lne18  2822.5368  195.7737  12.43  2397.6040  3247.4696
  lne19  3140.4759  195.7737  12.43  2715.5430  3565.4087
