<<CM13-3,eval=FALSE>>=
# Illustrative null: each difference from group 1 equals five response units.
C.tomato <- rbind(
    group2_group1 = c(-1, 1, 0),
    group3_group1 = c(-1, 0, 1)
)
st.lsm(
    m.tomato,
    ~x.v,
    method = C.tomato,
    rhs = c(5, 5),
    adjust = "none"
)
@

\begin{Soutput}
Least-squares mean contrasts (exact)
  contrast        null estimate     SE DF lower.CL upper.CL      t      p
  group2_group1 5.0000   5.0000 3.4761  4  -4.6512  14.6512 0.0000 1.0000
  group3_group1 5.0000  16.0000 3.4761  4   6.3488  25.6512 3.1645 0.0340
p-value adjustment: none; confidence level: 0.9500
\end{Soutput}

<<CM13-4,eval=FALSE>>=
# L columns refer to fitted coefficients; method columns refer to means.
# This no-intercept cell-means model makes the two matrices identical.
L.tomato <- C.tomato
colnames(L.tomato) <- names(coef(m.tomato))
h.tomato.L <- st.lsm(
    m.tomato,
    L = L.tomato,
    rhs = c(5, 5),
    adjust = "none"
)
h.tomato.L
@

\begin{Soutput}
Fixed-effect linear hypotheses (exact)
  hypothesis      null estimate     SE DF lower.CL upper.CL      t      p
  group2_group1 5.0000   5.0000 3.4761  4  -4.6512  14.6512 0.0000 1.0000
  group3_group1 5.0000  16.0000 3.4761  4   6.3488  25.6512 3.1645 0.0340
p-value adjustment: none; confidence level: 0.9500
\end{Soutput}

<<CM13-5,eval=FALSE>>=
# Jointly test both five-unit null differences.
st.lsm(
    h.tomato.L,
    joint = TRUE
)
@

\begin{Soutput}
Exact linear hypothesis
  DF1  DF2       F       p  F.scaling  method
    2    4  5.9606  0.0631     1.0000  exact 
\end{Soutput}


