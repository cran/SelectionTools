\subsection{Crossed random effects: Years and locations}
\mbox{\cde{M23: barley-met}}

<<M23-1,eval=FALSE>>=
data("v-lmm-barley-met", package = "SelectionTools")
m.m23.reml <- st.lmm(
    fixed = TKW ~ 1,
    random = ~gen + loc + year + gen:loc + gen:year + loc:year +
        gen:loc:year + rep:loc:year,
    data = barley.met
)
m.m23.reml
@

